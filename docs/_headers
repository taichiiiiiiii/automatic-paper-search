# Cloudflare Pages headers for the PaperPilot family-tree viewer.
# Reference: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# papers.json / lineage.json / conferences.json are regenerated by the weekly
# collect workflow. A short fresh window plus a longer stale-while-revalidate
# lets returning readers see updated data quickly without hammering the origin.
/*.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

# Shared CSS/JS under /assets/. Filenames aren't content-hashed, so keep the
# cache window short enough that a deploy's JS fix reaches users within an hour.
/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
