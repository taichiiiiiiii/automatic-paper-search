    {"label": "empty authors", "set": {"authors": []}, "valid": true},
    {"label": "null authors", "set": {"authors": null}, "valid": true},
    {"label": "null author entry", "set": {"authors": [null]}, "valid": false},
    {"label": "numeric author entry", "set": {"authors": [1]}, "valid": false},
    {"label": "authors as string", "set": {"authors": "A"}, "valid": false},
