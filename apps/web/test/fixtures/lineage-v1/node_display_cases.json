    {"label": "float year", "set": {"year": 2024.5}, "valid": false},
    {"label": "boolean year", "set": {"year": true}, "valid": false},
    {"label": "string year", "set": {"year": "2024"}, "valid": false},
    {"label": "numeric title", "set": {"title": 7}, "valid": false},
    {"label": "null title", "set": {"title": null}, "valid": false},
