{
  "name": "@paperpilot/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/copy-data.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/copy-data.ts",
    "build": "next build",
    "postbuild": "tsx scripts/strip-nojs.ts && tsx scripts/csp-hash.ts && tsx scripts/redirects.ts && tsx scripts/sitemap.ts",
    "copy-data": "tsx scripts/copy-data.ts",
    "csp-hash": "tsx scripts/csp-hash.ts",
    "legacy-redirects": "tsx scripts/legacy-redirects.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:request-flow": "playwright test -c playwright.request-flow.config.ts",
    "e2e:prod": "playwright test --grep @prod --grep-invert @prod-crawl",
    "e2e:crawl": "playwright test --grep @prod-crawl --project desktop-chromium",
    "e2e:install": "playwright install chromium webkit firefox",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@paperpilot/core": "workspace:*",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  }
}
