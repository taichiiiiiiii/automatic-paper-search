{
  // Production Cloudflare Worker config for apps/api (Hono port of
  // worker/, §4.5), prepared ahead of docs/migration/p5-plan.md §6.2
  // Phase W. Tier A / inert: nothing in this repo's deploy pipeline reads
  // this file yet — Workers Builds' root-directory setting still points
  // at `/` (root wrangler.jsonc / worker/index.ts) until Phase W step W3
  // repoints it at apps/api. Until then this file sits unused alongside
  // the preview config `wrangler.preview.jsonc` (same directory, local
  // use via `-c wrangler.preview.jsonc`).
  //
  // Same production Worker name/KV id as the pre-cutover root
  // wrangler.jsonc (§6.1: binding names are per-Worker, so `CONFIG_KV` ->
  // the same namespace id `RATE_LIMIT_KV` already binds is fine — the old
  // Worker's rate-limit keys do not collide with `accepting`,
  // `origin_allowlist` or `namespace_tag`). The id below is copied
  // verbatim from the root wrangler.jsonc's `kv_namespaces[0].id` — see
  // apps/api/test/wrangler-config.test.ts, which asserts this file's id
  // equals that file's id byte-for-byte rather than trusting a
  // transcription.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paperpilot-themes",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // DISPATCH_MODE=live (§4.5): this is the production config, so dry-run
  // must never be the configured mode here — see
  // apps/api/src/lib/dispatch-mode.ts's checkDispatchMode, which
  // independently refuses dry-run for GH_REF=="develop" or for a
  // PRODUCTION_ORIGINS match as a second, request-time guard against this
  // var ever being misconfigured back to dry-run.
  "vars": {
    "GH_OWNER": "taichiiiiiiii",
    "GH_REPO": "automatic-paper-search",
    "GH_WORKFLOW_FILE": "theme-on-demand.yml",
    "GH_REF": "develop",
    "DISPATCH_MODE": "live"
  },
  // §4.2-6/7: origin allowlist + accept-stop flag, read fresh per request.
  // Production namespace id — copy-verified against root wrangler.jsonc's
  // RATE_LIMIT_KV id by apps/api/test/wrangler-config.test.ts (do not
  // hand-edit this id without updating that test's expectation source,
  // which is the root file, not a literal in the test).
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "3e11d3e73dae42a8b94f06a9fa9de19f"
    }
  ],
  // §5: exact quota counting via a SQLite-backed Durable Object.
  // `new_sqlite_classes` (not `new_classes`) is required for the Free
  // plan per §4.5 — `new_classes` fails to deploy on Workers Free.
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTA",
        "class_name": "QuotaCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuotaCounter"]
    }
  ]
  // No d1_databases: apps/api has no D1-backed code (§0-4). Do not add a
  // binding nobody reads — that is a tracked P3/P6 gap, not this
  // changeset's job.
  //
  // No new secret here either: the GH_DISPATCH_PAT secret already exists
  // on the production Worker (set once via `wrangler secret put
  // GH_DISPATCH_PAT`, see worker/README.md) and persists across a
  // `main`/root-directory change in Workers Builds — secrets are
  // attached to the Worker, not to a specific config file.
}
