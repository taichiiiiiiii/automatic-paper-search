# Python bytecode from the .codex/ helper scripts (the only Python left,
# p5-plan.md §6.3 decision 8).
__pycache__/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Local build artifacts — S2 API response cache is regenerated on demand
# (40+ files of references_*.json / citations_*.json per run; not worth
# committing). LLM classification cache is the EXCEPTION: it accumulates
# paper-specific rationales across runs, and free-tier Groq's per-build
# TPM ceiling makes the cumulative amortisation across builds the only
# way to keep most edges paper-specific. So we ignore the directory's
# CONTENTS by default but un-ignore classifications.json explicitly.
# Git requires the dir itself to NOT be ignored for the negation to
# bite (a `dir/` rule ignores the directory wholesale and overrides
# any `!dir/file` inside it). See #131 followup.
data/state/lineage-cache/*
!data/state/lineage-cache/classifications.json
# R2-6: quota-degraded themes awaiting the scheduled retry (regen-retry.yml).
!data/state/lineage-cache/regen-pending.json

# unarXive citation contexts DuckDB (~7GB, Phase J). Downloaded from
# GitHub Releases on demand and read by apps/pipeline's lineage unarxive
# reader; never staged.
data/state/unarxive/

# TypeScript monorepo (docs/design/39-typescript-cloudflare-migration.md)
node_modules/
.next/
apps/web/out/
*.tsbuildinfo
.vitest/
coverage/

# vitest JSON reports written by the release no-skip gate (pages-release.yml)
.vitest-release-report.json

# P5 operator logs (apply, docs/migration/p5-plan.md §5.1) — never committed.
logs/
