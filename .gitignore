# Python test coverage
.coverage
.coverage.*
htmlcov/

# Editable-install build artifact (pip install -e .) — never commit
*.egg-info/
__pycache__/
# setuptools/hatchling staging dir. `uv run --extra dev` builds the project,
# which creates this; it appeared untracked during the 2026-08-23 merge prep.
build/
dist/


# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Local build artifacts — S2 API response cache is regenerated on demand
# (40+ files of references_*.json / citations_*.json per run; not worth
# committing). LLM classification cache is the EXCEPTION: it accumulates
# paper-specific rationales across runs, and free-tier Groq's per-build
# TPM ceiling makes the cumulative amortisation across builds the only
# way to keep most edges paper-specific. So we ignore the directory's
# CONTENTS by default but un-ignore classifications.json explicitly.
# Git requires the dir itself to NOT be ignored for the negation to
# bite (a `dir/` rule ignores the directory wholesale and overrides
# any `!dir/file` inside it). See #131 followup.
paperpilot/data/lineage-cache/*
!paperpilot/data/lineage-cache/classifications.json

# unarXive citation contexts DuckDB (Phase J). build_unarxive_index.py
# produces a ~7GB unarxive.duckdb under paperpilot/data/unarxive/; the
# release artefact lives on GitHub Releases (downloaded by CI on demand)
# so the local dir should never be staged.
paperpilot/data/unarxive/
