# Re-exclude credentials, caches, and mutable/generated runtime state even
# inside an allowlisted directory. Keep the public variable inventory.
.git/
**/.env
**/.env.*
!paperpilot/.env.example
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*credential*
**/*secret*
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.whl
paperpilot/output/**
paperpilot/logs/**
paperpilot/data/seen_ids*.json
paperpilot/data/run_history.jsonl
paperpilot/data/lineage-cache/**
paperpilot/data/unarxive/**

# Two tracked, public artifacts are path-contract fixtures for the full test
# suite. Keep only these exact files; all sibling generated state stays out.
!paperpilot/output/
!paperpilot/output/iclr-2026/
!paperpilot/output/iclr-2026/summary.csv
!paperpilot/data/lineage-cache/
