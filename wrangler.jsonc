{
  // Cloudflare Worker config for the /api/themes submission endpoint.
  // The static docs/ viewer ships from GitHub Pages; this Worker owns
  // /api/themes (POST) and /api/themes/status (GET) only. CF Workers
  // Builds auto-deploys on every push to develop.
  //
  // First-deploy setup (KV id + PAT secret + Access OFF): see the
  // "CF Worker (theme submission API)" section in CLAUDE.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name changed from "automatic-paper-search" to "paperpilot-themes"
  // on 2026-06-03 to escape a Cloudflare Access Application that had bound
  // itself to the old workers.dev hostname. The Application could not be
  // removed without activating Zero Trust Free, so renaming the Worker
  // was the lower-friction path. See CHANGELOG.md ## [Unreleased].
  "name": "paperpilot-themes",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  // Non-secret config — visible in the CF dashboard. The PAT itself is a
  // secret (set via `wrangler secret put GH_DISPATCH_PAT`).
  "vars": {
    "GH_OWNER": "taichiiiiiiii",
    "GH_REPO": "automatic-paper-search",
    "GH_WORKFLOW_FILE": "theme-on-demand.yml",
    "GH_REF": "develop"
  },
  // Per-IP rate limit + global daily cap. Replace the placeholder id with
  // the value `wrangler kv namespace create` prints (see Setup above).
  // Until that swap happens, deploys fail with a binding-validation error.
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "3e11d3e73dae42a8b94f06a9fa9de19f"
    }
  ]
}
