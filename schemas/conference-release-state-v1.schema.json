{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperpilot.local/schemas/conference-release-state-v1.schema.json",
  "title": "PaperPilot Conference Release State v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "editions"],
  "properties": {
    "schema_version": {"const": "conference-release-state-v1"},
    "editions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edition_id", "venue_key", "year", "phase", "last_observation",
          "stable_fingerprint", "stable_observations", "stable_since_at",
          "last_qualifying_at", "last_qualifying_run_id", "published_fingerprint",
          "published_count", "published_source_ids", "last_failure_code"
        ],
        "properties": {
          "edition_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$"},
          "venue_key": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "year": {"type": "integer", "minimum": 2000, "maximum": 2100},
          "phase": {"enum": ["unavailable", "partial", "stabilizing", "ready", "published", "anomaly"]},
          "last_observation": {
            "anyOf": [
              {"type": "null"},
              {"$ref": "conference-probe-observation-v1.schema.json"}
            ]
          },
          "stable_fingerprint": {"$ref": "#/$defs/nullableHash"},
          "stable_observations": {"type": "integer", "minimum": 0, "maximum": 2},
          "stable_since_at": {"$ref": "#/$defs/nullableTimestamp"},
          "last_qualifying_at": {"$ref": "#/$defs/nullableTimestamp"},
          "last_qualifying_run_id": {
            "anyOf": [
              {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
              {"type": "null"}
            ]
          },
          "published_fingerprint": {"$ref": "#/$defs/nullableHash"},
          "published_count": {
            "anyOf": [
              {"type": "integer", "minimum": 0, "maximum": 25000},
              {"type": "null"}
            ]
          },
          "published_source_ids": {
            "type": "array", "maxItems": 25000, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,256}$"}
          },
          "last_failure_code": {
            "anyOf": [
              {"type": "string", "pattern": "^CONF_[A-Z0-9_]+$"},
              {"type": "null"}
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "nullableHash": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "nullableTimestamp": {
      "anyOf": [
        {"type": "string", "format": "date-time", "pattern": "Z$"},
        {"type": "null"}
      ]
    }
  }
}
