{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local previous-edition ratio assessment (not publication authority)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "edition_id", "venue_key", "year", "status", "previous_edition_id", "previous_year", "previous_count", "current_count", "effective_minimum", "effective_maximum", "previous_catalog_sha256", "published_fingerprint", "current_source_fingerprint", "authority"],
  "properties": {
    "schema_version": {"const": "conference-baseline-assessment-v1"},
    "scope": {"const": "local_assessment_only"},
    "edition_id": {"$ref": "#/$defs/edition"},
    "venue_key": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z0-9-]+$"},
    "year": {"type": "integer", "minimum": 2001, "maximum": 2100},
    "status": {"enum": ["passed", "below_minimum", "above_maximum"]},
    "previous_edition_id": {"$ref": "#/$defs/edition"},
    "previous_year": {"type": "integer", "minimum": 2000, "maximum": 2099},
    "previous_count": {"$ref": "#/$defs/count"},
    "current_count": {"$ref": "#/$defs/count"},
    "effective_minimum": {"type": "integer", "minimum": 1, "maximum": 250000},
    "effective_maximum": {"type": "integer", "minimum": 1, "maximum": 250000},
    "previous_catalog_sha256": {"$ref": "#/$defs/hash"},
    "published_fingerprint": {"$ref": "#/$defs/hash"},
    "current_source_fingerprint": {"$ref": "#/$defs/hash"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trusted_persistent_state_proof", "baseline_state_trusted", "fresh_tip_checked", "staging_materialized", "promotion_authorized", "publication_authorized"],
      "properties": {
        "trusted_persistent_state_proof": {"const": false},
        "baseline_state_trusted": {"const": false},
        "fresh_tip_checked": {"const": false},
        "staging_materialized": {"const": false},
        "promotion_authorized": {"const": false},
        "publication_authorized": {"const": false}
      }
    }
  },
  "$defs": {
    "edition": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$"},
    "count": {"type": "integer", "minimum": 1, "maximum": 25000},
    "hash": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
  }
}
