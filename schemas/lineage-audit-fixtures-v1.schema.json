{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperpilot.local/schemas/lineage-audit-fixtures-v1.schema.json",
  "title": "PaperPilot Lineage Audit Fixtures v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collections"],
  "properties": {
    "schema_version": {"const": "lineage-audit-fixtures-v1"},
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "collection_id",
          "input_sha256",
          "reviewer",
          "reviewed_at",
          "focus_labels",
          "sample_labels"
        ],
        "properties": {
          "collection_id": {"type": "string"},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reviewer": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "format": "date-time"},
          "focus_labels": {"$ref": "#/$defs/labels"},
          "sample_labels": {
            "$ref": "#/$defs/labels",
            "maxItems": 20,
            "description": "At most 20 rows; the quality builder additionally requires at least min(20, node count) rows with distinct node_id values that exist in the graph, and at most 10% off-topic."
          },
          "draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the edited audit-draft JSON this entry was imported from (auditDraftCli import)."},
          "edge_labels": {
            "type": "array",
            "description": "Design doc 41 D5. Human verdicts on edges, keyed by src/dst/relation. The quality builder requires one row for every edge whose relation is in the policy's strong_relations (default contrasts, supersedes, extends, successor); each row must name an existing edge, appear once, and say verdict=correct. A wrong verdict (with or without corrected_relation) fails golden_fixture: corrections are not applied, so the artifact must be regenerated and re-audited.",
            "items": {"$ref": "#/$defs/edgeLabel"}
          }
        }
      }
    }
  },
  "$defs": {
    "edgeLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "dst", "relation", "verdict"],
      "properties": {
        "src": {"type": "string", "minLength": 1},
        "dst": {"type": "string", "minLength": 1},
        "relation": {"type": "string", "minLength": 1},
        "verdict": {"enum": ["correct", "wrong"]},
        "corrected_relation": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      },
      "if": {"properties": {"verdict": {"const": "correct"}}, "required": ["verdict"]},
      "then": {"not": {"required": ["corrected_relation"]}}
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "on_topic"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "on_topic": {"type": "boolean"},
          "metadata_ok": {"type": "boolean", "description": "Design doc 41 D5. Human verdict on the node's title/year/authors/identifier. false fails golden_fixture (no corrections are applied)."},
          "note": {"type": "string"}
        }
      }
    }
  }
}
