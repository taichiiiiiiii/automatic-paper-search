{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://paperpilot.local/schemas/lineage-audit-fixtures-v2.schema.json", "title": "PaperPilot Lineage Audit Fixtures v2",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "fixture_id", "created_at", "collections"],
  "properties": {"schema_version": {"const": "lineage-audit-fixtures-v2"}, "fixture_id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}, "collections": {"type": "array", "items": {"$ref": "#/$defs/collection"}}},
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "nullableRelation": {"enum": ["supersedes", "successor", "extends", "ablation", "baseline_only", "contrasts", null]}, "nullableFamily": {"enum": ["genealogy", "comparison", null]},
    "universe": {"type": "object", "additionalProperties": false, "required": ["snapshot_ref", "input_sha256", "selection_method", "candidate_count"], "properties": {"snapshot_ref": {"type": "string", "minLength": 1}, "input_sha256": {"$ref": "#/$defs/sha256"}, "selection_method": {"type": "string", "minLength": 1}, "candidate_count": {"type": "integer", "minimum": 0}}},
    "focusLabel": {"type": "object", "additionalProperties": false, "required": ["node_id", "on_topic"], "properties": {"node_id": {"type": "string", "minLength": 1}, "on_topic": {"type": "boolean"}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["reviewer_id", "blind_to_model", "blind_to_peer", "citation_valid", "gold_family", "gold_relation", "evidence_support", "notes", "reviewed_at"], "properties": {"reviewer_id": {"type": "string", "minLength": 1}, "blind_to_model": {"const": true}, "blind_to_peer": {"const": true}, "citation_valid": {"type": "boolean"}, "gold_family": {"$ref": "#/$defs/nullableFamily"}, "gold_relation": {"$ref": "#/$defs/nullableRelation"}, "evidence_support": {"enum": ["supports", "insufficient", "conflicts"]}, "notes": {"type": "string"}, "reviewed_at": {"type": "string", "format": "date-time"}}},
    "adjudication": {"type": "object", "additionalProperties": false, "required": ["adjudicator_id", "citation_valid", "gold_family", "gold_relation", "evidence_support", "notes", "reviewed_at"], "properties": {"adjudicator_id": {"type": "string", "minLength": 1}, "citation_valid": {"type": "boolean"}, "gold_family": {"$ref": "#/$defs/nullableFamily"}, "gold_relation": {"$ref": "#/$defs/nullableRelation"}, "evidence_support": {"enum": ["supports", "insufficient", "conflicts"]}, "notes": {"type": "string"}, "reviewed_at": {"type": "string", "format": "date-time"}}},
    "edgeLabel": {"type": "object", "additionalProperties": false, "required": ["review_id", "collection_id", "src", "dst", "evidence_sha256", "reviews", "adjudication"], "properties": {"review_id": {"type": "string", "minLength": 1}, "collection_id": {"type": "string", "minLength": 1}, "src": {"type": "string", "minLength": 1}, "dst": {"type": "string", "minLength": 1}, "evidence_sha256": {"$ref": "#/$defs/sha256"}, "reviews": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/review"}}, "adjudication": {"$ref": "#/$defs/adjudication"}}},
    "collection": {"type": "object", "additionalProperties": false, "required": ["collection_id", "release_id", "artifact_sha256", "candidate_universe", "focus_labels", "edge_labels"], "properties": {"collection_id": {"type": "string", "minLength": 1}, "release_id": {"type": "string", "minLength": 1}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "candidate_universe": {"$ref": "#/$defs/universe"}, "focus_labels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/focusLabel"}}, "edge_labels": {"type": "array", "items": {"$ref": "#/$defs/edgeLabel"}}}}
  }
}
