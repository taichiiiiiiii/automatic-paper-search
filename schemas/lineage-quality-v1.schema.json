{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperpilot.local/schemas/lineage-quality-v1.schema.json",
  "title": "PaperPilot Lineage Quality v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of", "audit_version", "collections"],
  "properties": {
    "schema_version": {"const": "lineage-quality-v1"},
    "as_of": {"type": "string", "format": "date-time"},
    "audit_version": {"const": "audit-v1"},
    "collections": {"type": "array", "items": {"$ref": "#/$defs/collection"}}
  },
  "$defs": {
    "sha256OrNull": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_id", "kind", "slug", "label", "path", "availability",
        "audit_status", "freshness", "generated_at", "snapshot_date", "node_count",
        "edge_count", "artifact_schema_version", "input_sha256", "audit"
      ],
      "properties": {
        "collection_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["conference", "theme"]},
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "label": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "availability": {"enum": ["unavailable", "sparse", "ready", "failed"]},
        "audit_status": {"enum": ["unknown", "passed", "failed"]},
        "publication_tier": {
          "enum": ["audited", "unaudited", "blocked"],
          "description": "Design doc 41 D1. audited = ready + every check passed (golden_fixture included); unaudited = ready + every automatic check passed and golden_fixture unknown; blocked = everything else. Optional only so pre-tier manifests still validate; the builder always writes it."
        },
        "freshness": {"enum": ["fresh", "stale"]},
        "generated_at": {
          "anyOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]
        },
        "snapshot_date": {
          "anyOf": [{"type": "null"}, {"type": "string", "format": "date"}]
        },
        "node_count": {"type": "integer", "minimum": 0},
        "edge_count": {"type": "integer", "minimum": 0},
        "artifact_schema_version": {"type": ["string", "null"]},
        "input_sha256": {"$ref": "#/$defs/sha256OrNull"},
        "audit": {"$ref": "#/$defs/audit"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "conference"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "collection_id": {"pattern": "^conference:"},
              "path": {"pattern": "^[a-z0-9][a-z0-9-]*/lineage\\.json$"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "theme"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "collection_id": {"pattern": "^theme:"},
              "path": {"pattern": "^themes/[a-z0-9][a-z0-9-]*/lineage\\.json$"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability": {"const": "ready"},
              "audit_status": {"const": "passed"}
            },
            "required": ["availability", "audit_status"]
          },
          "then": {
            "properties": {
              "artifact_schema_version": {"const": "lineage-artifact-v1"},
              "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "audit": {
                "properties": {
                  "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "checks": {
                    "minItems": 1,
                    "items": {"properties": {"status": {"const": "passed"}}},
                    "allOf": [
                      {
                        "contains": {
                          "properties": {"name": {"const": "artifact_contract_v1"}},
                          "required": ["name"]
                        }
                      },
                      {
                        "contains": {
                          "properties": {"name": {"const": "golden_fixture"}},
                          "required": ["name"]
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"publication_tier": {"const": "audited"}},
            "required": ["publication_tier"]
          },
          "then": {
            "properties": {
              "availability": {"const": "ready"},
              "audit_status": {"const": "passed"}
            }
          }
        },
        {
          "if": {
            "properties": {"publication_tier": {"const": "unaudited"}},
            "required": ["publication_tier"]
          },
          "then": {
            "properties": {
              "availability": {"const": "ready"},
              "audit_status": {"const": "unknown"},
              "artifact_schema_version": {"const": "lineage-artifact-v1"},
              "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "audit": {
                "properties": {
                  "checks": {
                    "minItems": 1,
                    "items": {
                      "if": {"properties": {"name": {"not": {"const": "golden_fixture"}}}},
                      "then": {"properties": {"status": {"const": "passed"}}},
                      "else": {"properties": {"status": {"const": "unknown"}}}
                    },
                    "contains": {
                      "properties": {"name": {"const": "golden_fixture"}},
                      "required": ["name"]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability": {"const": "ready"},
              "audit_status": {"const": "passed"}
            },
            "required": ["availability", "audit_status", "publication_tier"]
          },
          "then": {"properties": {"publication_tier": {"const": "audited"}}}
        },
        {
          "if": {
            "properties": {"audit_status": {"const": "failed"}},
            "required": ["audit_status"]
          },
          "then": {
            "properties": {
              "audit": {
                "properties": {
                  "checks": {
                    "contains": {
                      "properties": {"status": {"const": "failed"}},
                      "required": ["status"]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_sha256", "evaluated_at", "actor", "checks"],
      "properties": {
        "fixture_sha256": {"$ref": "#/$defs/sha256OrNull"},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "actor": {"const": "ci:audit-v1"},
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "observed", "expected", "evidence"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "status": {"enum": ["unknown", "passed", "failed"]},
              "observed": {}, "expected": {},
              "evidence": {
                "type": "array", "maxItems": 20, "items": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
