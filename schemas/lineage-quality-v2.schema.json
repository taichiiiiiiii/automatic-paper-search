{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://paperpilot.local/schemas/lineage-quality-v2.schema.json", "title": "PaperPilot Lineage Quality v2",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "audit_version", "as_of", "collections"],
  "properties": {"schema_version": {"const": "lineage-quality-v2"}, "audit_version": {"const": "audit-v2"}, "as_of": {"type": "string", "format": "date-time"}, "collections": {"type": "array", "items": {"$ref": "#/$defs/collection"}}},
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "nullableNumber": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "nullableText": {"type": ["string", "null"]},
    "decisionCounts": {"type": "object", "additionalProperties": false, "required": ["accepted", "unknown", "abstained", "rejected"], "properties": {"accepted": {"type": "integer", "minimum": 0}, "unknown": {"type": "integer", "minimum": 0}, "abstained": {"type": "integer", "minimum": 0}, "rejected": {"type": "integer", "minimum": 0}}},
    "calibration": {"type": "object", "additionalProperties": false, "required": ["status", "reason", "sample_count", "wilson_lower_bound", "supersedes_wilson_lower_bound", "macro_precision", "ece", "brier", "accepted_coverage", "unknown_abstained_recall"], "properties": {"status": {"enum": ["passed", "failed", "insufficient_sample", "not_applicable"]}, "reason": {"type": "string"}, "sample_count": {"type": "integer", "minimum": 0}, "wilson_lower_bound": {"$ref": "#/$defs/nullableNumber"}, "supersedes_wilson_lower_bound": {"$ref": "#/$defs/nullableNumber"}, "macro_precision": {"$ref": "#/$defs/nullableNumber"}, "ece": {"$ref": "#/$defs/nullableNumber"}, "brier": {"$ref": "#/$defs/nullableNumber"}, "accepted_coverage": {"$ref": "#/$defs/nullableNumber"}, "unknown_abstained_recall": {"$ref": "#/$defs/nullableNumber"}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["status", "reviewed_claim_count", "agreement", "fixture_id"], "properties": {"status": {"enum": ["unknown", "passed", "failed", "not_applicable"]}, "reviewed_claim_count": {"type": "integer", "minimum": 0}, "agreement": {"$ref": "#/$defs/nullableNumber"}, "fixture_id": {"$ref": "#/$defs/nullableText"}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["name", "status", "detail"], "properties": {"name": {"type": "string", "minLength": 1}, "status": {"enum": ["unknown", "passed", "failed", "not_applicable"]}, "detail": {"type": "string"}}},
    "collection": {"type": "object", "additionalProperties": false, "required": ["collection_id", "kind", "slug", "label", "path", "release_id", "release_profile", "availability", "audit_status", "artifact_schema_version", "artifact_sha256", "fixture_sha256", "node_count", "link_count", "claim_decision_count", "accepted_genealogy_count", "accepted_comparison_count", "decision_counts", "calibration", "review", "checks"], "properties": {"collection_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["conference", "theme", "deep"]}, "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "label": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "release_id": {"type": "string", "minLength": 1}, "release_profile": {"enum": ["claim-verified-pilot-v1", "automated-calibrated-v1"]}, "availability": {"enum": ["unavailable", "sparse", "ready", "failed"]}, "audit_status": {"enum": ["unknown", "passed", "failed"]}, "artifact_schema_version": {"const": "lineage-artifact-v2"}, "artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "fixture_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "node_count": {"type": "integer", "minimum": 0}, "link_count": {"type": "integer", "minimum": 0}, "claim_decision_count": {"type": "integer", "minimum": 0}, "accepted_genealogy_count": {"type": "integer", "minimum": 0}, "accepted_comparison_count": {"type": "integer", "minimum": 0}, "decision_counts": {"$ref": "#/$defs/decisionCounts"}, "calibration": {"$ref": "#/$defs/calibration"}, "review": {"$ref": "#/$defs/review"}, "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}}, "allOf": [{"if": {"properties": {"availability": {"const": "ready"}, "audit_status": {"const": "passed"}}, "required": ["availability", "audit_status"]}, "then": {"properties": {"artifact_sha256": {"$ref": "#/$defs/sha256"}, "fixture_sha256": {"$ref": "#/$defs/sha256"}}}}]}
  }
}
