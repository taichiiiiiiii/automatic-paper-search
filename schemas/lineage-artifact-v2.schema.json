{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperpilot.local/schemas/lineage-artifact-v2.schema.json",
  "title": "PaperPilot Lineage Artifact v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "root", "nodes", "links", "evidence", "claims", "clusters", "meta"],
  "properties": {
    "schema_version": {"const": "lineage-artifact-v2"},
    "release_id": {"type": "string", "minLength": 1},
    "root": {"type": ["string", "null"]},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "clusters": {"type": "array"},
    "meta": {"$ref": "#/$defs/meta"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableText": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "first_published_at", "is_focus", "seed_paper_id", "aliases"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1},
        "first_published_at": {"type": "string", "anyOf": [{"format": "date"}, {"format": "date-time"}]}, "is_focus": {"type": "boolean"},
        "seed_paper_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"enum": ["arxiv", "openreview", "acl_anthology", "cvf", "doi"]}, {"type": "string", "minLength": 1}]}}
      },
      "allOf": [{"if": {"properties": {"is_focus": {"const": true}}, "required": ["is_focus"]}, "then": {"properties": {"seed_paper_id": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}, "else": {"properties": {"seed_paper_id": {"type": "null"}}}}]
    },
    "link": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "src", "dst", "type", "evidence_ids"],
      "properties": {"id": {"type": "string", "minLength": 1}, "src": {"type": "string", "minLength": 1}, "dst": {"type": "string", "minLength": 1}, "type": {"const": "citation"}, "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    },
    "locator": {
      "type": "object", "additionalProperties": false,
      "required": ["page", "section", "reference_marker", "sentence_ordinal", "paragraph_ordinal"],
      "properties": {"page": {"type": ["integer", "null"], "minimum": 1}, "section": {"$ref": "#/$defs/nullableText"}, "reference_marker": {"$ref": "#/$defs/nullableText"}, "sentence_ordinal": {"type": ["integer", "null"], "minimum": 0}, "paragraph_ordinal": {"type": ["integer", "null"], "minimum": 0}},
      "anyOf": [{"properties": {"page": {"type": "integer"}}}, {"properties": {"section": {"type": "string"}}}, {"properties": {"reference_marker": {"type": "string"}}}, {"properties": {"sentence_ordinal": {"type": "integer"}}}, {"properties": {"paragraph_ordinal": {"type": "integer"}}}]
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "kind", "source_work_id", "cited_work_id", "citing_work_id", "url", "locator", "excerpt", "excerpt_sha256", "input_sha256", "retrieved_at", "snapshot_ref"],
      "properties": {"id": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "source_work_id": {"type": "string", "minLength": 1}, "cited_work_id": {"type": "string", "minLength": 1}, "citing_work_id": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri"}, "locator": {"$ref": "#/$defs/locator"}, "excerpt": {"type": "string", "minLength": 1, "maxLength": 280}, "excerpt_sha256": {"$ref": "#/$defs/sha256"}, "input_sha256": {"$ref": "#/$defs/sha256"}, "retrieved_at": {"type": "string", "format": "date-time"}, "snapshot_ref": {"type": "string", "minLength": 1}}
    },
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "provider", "model", "prompt_version", "schema_version"],
      "properties": {"method": {"enum": ["human_review", "llm", "citation_heuristic", "intent_map", "context_pattern", "year_cite", "title_version", "foundational_allowlist"]}, "provider": {"$ref": "#/$defs/nullableText"}, "model": {"$ref": "#/$defs/nullableText"}, "prompt_version": {"$ref": "#/$defs/nullableText"}, "schema_version": {"type": "string", "minLength": 1}},
      "allOf": [{"if": {"properties": {"method": {"const": "llm"}}, "required": ["method"]}, "then": {"properties": {"provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "prompt_version": {"type": "string", "minLength": 1}}}}]
    },
    "reviewBinding": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["review_id", "fixture_id", "evidence_sha256"],
      "properties": {"review_id": {"type": "string", "minLength": 1}, "fixture_id": {"type": "string", "minLength": 1}, "evidence_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "src", "dst", "claim_family", "relation", "decision", "trust_tier", "raw_score", "calibrated_probability", "calibration_id", "evidence_ids", "rationale", "classification", "reason_codes", "review_binding"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "src": {"type": "string", "minLength": 1}, "dst": {"type": "string", "minLength": 1},
        "claim_family": {"enum": ["genealogy", "comparison"]}, "relation": {"type": ["string", "null"], "enum": ["supersedes", "successor", "extends", "ablation", "baseline_only", "contrasts", null]},
        "decision": {"enum": ["accepted", "unknown", "abstained", "rejected"]}, "trust_tier": {"enum": ["verified", "corroborated", "tentative"]},
        "raw_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "calibrated_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "calibration_id": {"$ref": "#/$defs/nullableText"},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "rationale": {"type": "string"}, "classification": {"$ref": "#/$defs/classification"}, "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "review_binding": {"$ref": "#/$defs/reviewBinding"}
      },
      "allOf": [
        {"if": {"properties": {"decision": {"enum": ["accepted", "rejected"]}}, "required": ["decision"]}, "then": {"properties": {"rationale": {"type": "string", "minLength": 1}, "relation": {"type": "string"}}}},
        {"if": {"properties": {"decision": {"enum": ["unknown", "abstained"]}}, "required": ["decision"]}, "then": {"properties": {"relation": {"type": "null"}, "reason_codes": {"minItems": 1}}}},
        {"if": {"properties": {"claim_family": {"const": "genealogy"}, "decision": {"enum": ["accepted", "rejected"]}}, "required": ["claim_family", "decision"]}, "then": {"properties": {"relation": {"enum": ["supersedes", "successor", "extends"]}}}},
        {"if": {"properties": {"claim_family": {"const": "comparison"}, "decision": {"enum": ["accepted", "rejected"]}}, "required": ["claim_family", "decision"]}, "then": {"properties": {"relation": {"enum": ["ablation", "baseline_only", "contrasts"]}}}},
        {"if": {"properties": {"trust_tier": {"const": "corroborated"}, "decision": {"const": "accepted"}}, "required": ["trust_tier", "decision"]}, "then": {"properties": {"calibrated_probability": {"type": "number"}, "calibration_id": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"trust_tier": {"const": "verified"}, "decision": {"const": "accepted"}}, "required": ["trust_tier", "decision"]}, "then": {"properties": {"review_binding": {"type": "object"}}}}
      ]
    },
    "meta": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "producer", "generated_at", "candidate_universe"],
      "properties": {"kind": {"enum": ["conference", "theme", "deep"]}, "producer": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}, "generated_at": {"type": "string", "format": "date-time"}, "candidate_universe": {"type": "object", "additionalProperties": false, "required": ["snapshot_ref", "input_sha256", "selection_method", "candidate_count"], "properties": {"snapshot_ref": {"type": "string", "minLength": 1}, "input_sha256": {"$ref": "#/$defs/sha256"}, "selection_method": {"type": "string", "minLength": 1}, "candidate_count": {"type": "integer", "minimum": 0}}}}
    }
  }
}
