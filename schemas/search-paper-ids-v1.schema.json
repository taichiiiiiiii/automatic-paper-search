{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperpilot.local/schemas/search-paper-ids-v1.schema.json",
  "title": "PaperPilot Search Paper ID Block v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "block", "start", "paper_ids"],
  "properties": {
    "schema_version": {"const": "search-paper-ids-v1"},
    "block": {"type": "integer", "minimum": 0},
    "start": {"type": "integer", "minimum": 0},
    "paper_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
    }
  }
}
