{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperpilot.local/schemas/deep-manifest-v1.schema.json",
  "title": "PaperPilot Deep Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "conference", "generated_at", "entries"],
  "properties": {
    "schema_version": {"const": "deep-manifest-v1"},
    "conference": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paper_id", "aliases", "arxiv_id", "title", "filename"],
        "properties": {
          "paper_id": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "aliases": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "array",
              "prefixItems": [
                {"enum": ["arxiv", "semantic_scholar"]},
                {"type": "string", "minLength": 1}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "arxiv_id": {"type": "string", "pattern": "^\\d{4}\\.\\d{4,5}(v\\d+)?$"},
          "title": {"type": "string", "minLength": 1},
          "filename": {
            "type": "string",
            "pattern": "^deep-\\d{4}\\.\\d{4,5}(v\\d+)?\\.json$"
          }
        }
      }
    }
  }
}
