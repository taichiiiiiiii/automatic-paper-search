# Copy this file to .env and fill in the values you have.
# All variables are optional — modules gracefully skip themselves when secrets are missing.

# ---------- Sources ----------

# GitHub API token (optional, raises rate limit 60 -> 5000 req/h)
# Generate at: https://github.com/settings/tokens (no scopes required for public repos)
PAPERPILOT_GITHUB_TOKEN=

# Semantic Scholar API key (optional, higher rate limits)
PAPERPILOT_S2_API_KEY=

# OpenAlex contact email (optional; puts you in the polite pool)
PAPERPILOT_OPENALEX_EMAIL=

# ---------- LLM (Stage 4) ----------

# Gemini API key (required if llm.provider == "gemini"). Free tier at
# https://aistudio.google.com/apikey
PAPERPILOT_GEMINI_API_KEY=

# Claude API key (reserved for a future Claude provider)
PAPERPILOT_CLAUDE_API_KEY=

# ---------- Exporters ----------

# Slack incoming webhook URL (Slack exporter + GitHub Actions failure notify)
PAPERPILOT_SLACK_WEBHOOK_URL=

# Email / SMTP (Email exporter)
PAPERPILOT_SMTP_SERVER=
PAPERPILOT_SMTP_PORT=587
PAPERPILOT_SMTP_USER=
PAPERPILOT_SMTP_PASSWORD=
PAPERPILOT_SMTP_USE_TLS=true
PAPERPILOT_EMAIL_TO=
