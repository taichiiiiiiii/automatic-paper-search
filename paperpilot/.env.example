# Copy this file to .env and fill in the values you have.
# All variables are optional for the MVP (Stage 0..2).
# Variables marked "future" are reserved for Stage 3/4 and optional exporters.

# GitHub API token (optional, raises rate limit 60 -> 5000 req/h)
# Generate at: https://github.com/settings/tokens (no scopes required for public repos)
PAPERPILOT_GITHUB_TOKEN=

# Semantic Scholar API key (optional, enables higher rate limits for S2 batch APIs)
PAPERPILOT_S2_API_KEY=

# OpenAlex email (optional, polite-pool identifier for OpenAlex source) — future
PAPERPILOT_OPENALEX_EMAIL=

# Claude API key (required for Stage 4 LLM reranking) — future
PAPERPILOT_CLAUDE_API_KEY=

# Slack incoming webhook URL (Slack exporter + GitHub Actions failure notify)
PAPERPILOT_SLACK_WEBHOOK_URL=

# Email SMTP settings (Email exporter) — future
PAPERPILOT_SMTP_SERVER=
PAPERPILOT_SMTP_USER=
PAPERPILOT_SMTP_PASSWORD=
PAPERPILOT_EMAIL_TO=
