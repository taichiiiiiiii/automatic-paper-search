# Copy this file to .env and fill in the values you have.
# All variables are optional — modules gracefully skip themselves when secrets are missing.

# ---------- Sources ----------

# GitHub API token (optional, raises rate limit 60 -> 5000 req/h)
# Generate at: https://github.com/settings/tokens (no scopes required for public repos)
PAPERPILOT_GITHUB_TOKEN=

# Semantic Scholar API key (optional, higher rate limits)
PAPERPILOT_S2_API_KEY=

# OpenAlex contact email (optional; puts you in the polite pool)
PAPERPILOT_OPENALEX_EMAIL=

# ---------- LLM (Stage 4) ----------

# Gemini API key (required if llm.provider == "gemini"). Free tier at
# https://aistudio.google.com/apikey
PAPERPILOT_GEMINI_API_KEY=

# Claude API key (reserved for a future Claude provider)
PAPERPILOT_CLAUDE_API_KEY=

# Groq API key (llm.provider == "groq"; also used by build_lineage.py for
# relation classification). Free tier (llama-3.3-70b-versatile, verified
# 2026-06-06): 30 RPM / 1,000 RPD / 12K TPM / 100K TPD. Daily counters
# look rolling-24h, not midnight UTC. Live limits at
# https://console.groq.com/docs/rate-limits — get a key at
# https://console.groq.com/keys
PAPERPILOT_GROQ_API_KEY=

# Override which provider build_lineage.py uses, ignoring key-presence order
# (normally: Groq key wins, then Gemini). Values: groq | gemini
PAPERPILOT_LLM_PROVIDER=

# Override the model id per provider (otherwise config.yaml decides).
PAPERPILOT_GROQ_MODEL=
PAPERPILOT_GEMINI_MODEL=

# Unprefixed fallbacks. build_lineage.py accepts these when the PAPERPILOT_*
# key above is absent, so a one-off run can use ambient credentials
# (`GROQ_API_KEY=... uv run python -m paperpilot.scripts.build_lineage`).
# Leave blank unless you rely on that.
# GROQ_API_KEY=
# GEMINI_API_KEY=

# ---------- Exporters ----------

# Slack incoming webhook URL (Slack exporter + GitHub Actions failure notify)
PAPERPILOT_SLACK_WEBHOOK_URL=

# Email / SMTP (Email exporter)
PAPERPILOT_SMTP_SERVER=
PAPERPILOT_SMTP_PORT=587
PAPERPILOT_SMTP_USER=
PAPERPILOT_SMTP_PASSWORD=
PAPERPILOT_SMTP_USE_TLS=true
PAPERPILOT_EMAIL_TO=

# ---------- Google Sheets sync (paperpilot/scripts/sync_to_sheets.py) ----------

# Path to a Google service-account JSON key. Standard Google SDK variable.
# Setup steps are in paperpilot/scripts/README.md.
GOOGLE_APPLICATION_CREDENTIALS=

# Target spreadsheet id (from its URL). Omit to create a new spreadsheet.
PAPERPILOT_SHEET_ID=

# Address to share a newly created spreadsheet with — a service account's
# sheet is invisible to you otherwise.
PAPERPILOT_SHEET_SHARE_EMAIL=
