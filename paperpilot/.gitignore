# Secrets - never commit
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/

# Logs (rotated locally; CI does not commit them)
logs/*.log

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Note: output/ and data/ are intentionally tracked so GitHub Actions
# runs can persist results and seen-ids across executions.
