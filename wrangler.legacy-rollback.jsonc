{
  // Rollback config for the OLD `worker/` Worker (pre-apps/api
  // production). NOT a deploy path today — Workers Builds only reads
  // whichever file its dashboard "config file" setting names, and that
  // setting is never pointed at this file as part of any automated
  // workflow in this repo. This exists purely as operator-run rollback
  // material for docs/migration/p5-plan.md §6.2 Phase W's ↩ step: if the
  // apps/api cutover needs to be undone, an operator runs
  //   wrangler deploy -c wrangler.legacy-rollback.jsonc
  // to put the old `worker/` request-handling code back in front of
  // production traffic.
  //
  // Identical to the production root wrangler.jsonc (same name, so this
  // redeploys onto the SAME Worker rather than creating a new one; same
  // vars; same RATE_LIMIT_KV binding/id) EXCEPT:
  //   - `main` points at worker/rollback-entry.ts, not worker/index.ts,
  //     because this file also carries a stub `QuotaCounter` class (see
  //     that file's header comment for why).
  //   - It adds the `QUOTA` Durable Object binding + `v1`
  //     (`new_sqlite_classes`) migration, matching apps/api's production
  //     wrangler.jsonc exactly, so a rollback deploy is compatible with
  //     the migration history apps/api already introduced on this
  //     Worker (**verify** against current Cloudflare docs — see
  //     worker/rollback-entry.ts's header comment and §6.2 Phase W's
  //     "do not roll back to a pre-DO version" note).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paperpilot-themes",
  "main": "worker/rollback-entry.ts",
  "compatibility_date": "2026-04-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "GH_OWNER": "taichiiiiiiii",
    "GH_REPO": "automatic-paper-search",
    "GH_WORKFLOW_FILE": "theme-on-demand.yml",
    "GH_REF": "develop"
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "3e11d3e73dae42a8b94f06a9fa9de19f"
    }
  ],
  // Stub-only binding — see worker/rollback-entry.ts. Kept so this config
  // stays compatible with the `QUOTA` migration apps/api's production
  // wrangler.jsonc already applies to this Worker.
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTA",
        "class_name": "QuotaCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuotaCounter"]
    }
  ]
}
